# Nur für die Browser-Tests (npm run test:e2e): Bei APP_ENV=e2e lädt Laravel
# diese Datei statt der .env. Der Schlüssel schützt nichts als die
# Wegwerf-Datenbank darunter und darf deshalb im Repository stehen.
APP_ENV=e2e
APP_KEY=base64:aR37pb4OmmkpFj8ygFltY4K2WPYErOFIBy3f1XAz7zI=
APP_DEBUG=true

BCRYPT_ROUNDS=4

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite
# Eine URL aus der Umgebung ersetzte sonst Treiber und Datenbank darüber
DB_URL=

# Was die App in die Warteschlange stellt, läuft im Request mit, statt
# ungesehen liegen zu bleiben
QUEUE_CONNECTION=sync

# Ein Mailer aus der Umgebung verschickte sonst echte Mails
MAIL_MAILER=log
