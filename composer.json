{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ringostarr80/kumiator",
    "type": "project",
    "description": "Web-based management platform for associations.",
    "keywords": [
        "association",
        "management",
        "membership"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "blade-ui-kit/blade-heroicons": "^2.7",
        "laravel/framework": "^13.21",
        "laravel/jetstream": "^5.5",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.3",
        "nyholm/psr7": "^1.8",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-permission": "^8.3",
        "symfony/psr-http-message-bridge": "^8.1",
        "web-auth/webauthn-lib": "^5.3"
    },
    "require-dev": {
        "brianium/paratest": "^7.23",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpat/phpat": "^0.12",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "phpunit/phpunit": "^13.2",
        "slevomat/coding-standard": "^8.31",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "@php artisan db:seed --class=RoleSeeder --force",
            "npm install",
            "npm run build"
        ],
        "deploy": [
            "composer install --no-dev --optimize-autoloader",
            "npm ci",
            "npm run build",
            "@php artisan migrate --force",
            "@php artisan db:seed --class=RoleSeeder --force",
            "@php artisan config:cache",
            "@php artisan route:cache",
            "@php artisan view:cache",
            "@php artisan queue:restart"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "dev:analyze:phpstan": "@dev:analyze:phpstan-8.4",
        "dev:analyze:phpstan-8.4": "vendor/bin/phpstan analyse --configuration=phpstan-8.4.neon --memory-limit=512M",
        "dev:analyze:phpstan-8.5": "vendor/bin/phpstan analyse --configuration=phpstan-8.5.neon --memory-limit=512M",
        "dev:analyze:phpat": "vendor/bin/phpstan analyse --configuration=phpstan-arch.neon --memory-limit=512M",
        "dev:lint": [
            "@dev:lint:php",
            "@dev:lint:phpcs"
        ],
        "dev:lint:php": "parallel-lint --exclude vendor .",
        "dev:lint:phpcs": "vendor/bin/phpcs",
        "dev:lint:fix": [
            "vendor/bin/pint",
            "vendor/bin/phpcbf"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test --coverage --parallel"
        ],
        "test:debug": [
            "@putenv XDEBUG_MODE=debug",
            "@putenv XDEBUG_TRIGGER=1",
            "@putenv PCOV_ENABLED=0",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.1"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
